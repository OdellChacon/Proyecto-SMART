# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# --- Base de datos (docker-compose y Django) ---
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-secreta
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origen del frontend: se usa para CSRF y para armar los enlaces de los correos.
FRONTEND_URL=http://localhost:5180
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5180
# Cantidad de proxies delante de Django (Cloudflare + Render = 2). En local: 0.
DJANGO_NUM_PROXIES=0

# --- Correo ---
# En desarrollo va a Mailpit (http://localhost:8026).
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1026
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Nombre de la Universidad <no-responder@universidad.edu.ve>

# Quién recibe los avisos de los formularios del sitio (separados por coma).
CORREOS_AVISO_FORMULARIOS=admision@universidad.edu.ve

# --- Analítica sin cookies: Cloudflare Web Analytics (vacío = desactivada) ---
VITE_CF_ANALYTICS_TOKEN=

# --- Archivos en Cloudflare R2 (solo producción; vacío = disco local) ---
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DOMINIO_PUBLICO=

# --- Antispam: Cloudflare Turnstile (vacío = desactivado, solo en desarrollo) ---
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- Mailpit (solo desarrollo) ---
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# --- Frontend ---
# A dónde reenvía el servidor de desarrollo de Vite las llamadas a /api.
VITE_API_PROXY_TARGET=http://127.0.0.1:8077
# A dónde pide los datos el servidor web (render en servidor). En producción, la URL interna de la API.
API_INTERNA_URL=http://127.0.0.1:8077

# Clave de las cuentas de demostración del panel (crear_usuarios_demo). Solo local.
DEMO_CLAVE_PANEL=
